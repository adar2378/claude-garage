# Local-dev override for hacking on the nocterm fork.
#
# Copy to pubspec_overrides.yaml (gitignored) and adjust the path to your
# checkout of https://github.com/adar2378/nocterm (branch: garage).
# `dart pub get` picks it up automatically; delete the file (and pub get
# again) to go back to the pinned git dependency in pubspec.yaml.
#
# When a change on the fork is ready: commit + push it on the `garage`
# branch, update the pinned ref in pubspec.yaml (and vendor/NOCTERM_VERSION),
# and register the patch in GARAGE_PATCHES.md on the fork.

dependency_overrides:
  nocterm:
    path: /Users/saifulislam/Development/personal/nocterm
