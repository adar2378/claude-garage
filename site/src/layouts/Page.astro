---
import Base from './Base.astro';
import '../styles/marketing.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props { title: string; description: string; jsonLd?: object; ogType?: string; ogImage?: string; ogAlt?: string; active?: 'blog' | 'compare' | 'about' | '' }
const { title, description, jsonLd, ogType, ogImage, ogAlt, active = '' } = Astro.props;
---
<Base title={title} description={description} jsonLd={jsonLd} ogType={ogType} ogImage={ogImage} ogAlt={ogAlt}>
  <slot name="head" slot="head" />
  <SiteHeader active={active || ''} />
  <main class="mk"><slot /></main>
  <footer class="mk-foot">
    <a href="/docs/guides/install/">Install</a>
    <a href="/try/">Try it in your browser</a>
    <a href="/docs/guides/first-plugin/">Build a plugin</a>
    <a href="/docs/guides/contributing/">Contribute</a>
    <a href="/about/">About</a>
    <a href="/docs/changelog/">Changelog</a>
    <a href="/blog/rss.xml">RSS</a>
    <span>MIT licensed. Not affiliated with Anthropic.</span>
  </footer>
</Base>
