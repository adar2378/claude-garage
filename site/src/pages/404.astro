---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | claude-garage" description="This page does not exist." noindex>
  <main style="max-width:36rem;margin:0 auto;padding:20vh 1.5rem;">
    <h1 style="margin:0 0 .5rem;color:var(--sl-color-white)">404</h1>
    <p style="color:var(--sl-color-gray-2)">That page is not here. Try the <a href="/docs/" style="color:var(--brand-high)">documentation</a> or go <a href="/" style="color:var(--brand-high)">home</a>.</p>
  </main>
</Base>
