---
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import { entityGraph } from '../lib/site';

const title = 'claude-garage: manage multiple Claude Code sessions in one terminal';
const description =
  'See every Claude Code session at once, jump to the one that needs you, and keep sessions alive in tmux. For macOS and Linux, with a Windows preview.';
// The one place the shared entities are defined. Every other page references them by @id.
// The hero render sits inside an inline SVG <image>, which the preload scanner cannot see, so it is preloaded explicitly below.
const jsonLd = { '@context': 'https://schema.org', '@graph': entityGraph() };
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <link slot="head" rel="preload" as="image" href="/renders/wall-needs-input.svg" fetchpriority="high" />
  <Landing />
</Base>
