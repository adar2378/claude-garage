---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { AUTHOR, PUBLISHER } from '../../lib/site';

export async function getStaticPaths() {
  const pages = await getCollection('compare');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page, all: pages.map((p) => ({ id: p.id, title: p.data.title, order: p.data.order })) } }));
}
const { page, all } = Astro.props;
const { Content } = await render(page);
const d = page.data;
const site = Astro.site ?? new URL('https://claude-garage.xyz');
const url = new URL(`/compare/${page.id}/`, site).href;
const UPDATED = '2026-11-01';
const related = all.filter((p) => p.id !== page.id).sort((a, b) => a.order - b.order);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: d.title,
      description: d.description,
      url,
      dateModified: UPDATED,
      inLanguage: 'en',
      author: AUTHOR,
      publisher: PUBLISHER,
    },
    {
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.origin + '/' },
        { '@type': 'ListItem', position: 2, name: 'Compare', item: new URL('/compare/', site).href },
        { '@type': 'ListItem', position: 3, name: d.title, item: url },
      ],
    },
  ],
};
---
<Page title={`${d.title} | claude-garage`} description={d.description} jsonLd={jsonLd} active="compare">
  <p class="crumbs"><a href="/">Home</a> / <a href="/compare/">Compare</a></p>
  <h1>{d.title}</h1>
  <p class="meta">By <a href="https://github.com/adar2378">Saiful Islam</a>, creator of claude-garage · Last updated <time datetime={UPDATED}>November 1, 2026</time></p>
  <p class="lead">{d.intro}</p>
  <p class="cta"><a class="btn primary" href="/docs/getting-started/install/">Install claude-garage</a><a class="btn" href="/docs/guides/first-wall/">First wall guide</a></p>

  <h2>Who is claude-garage for, compared with {d.otherLabel}?</h2>
  <ul>{d.who.map((w) => <li>{w}</li>)}</ul>

  <h2>What you get and what you give up</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th scope="col">Topic</th><th scope="col">claude-garage</th><th scope="col" style="text-transform:capitalize">{d.otherLabel}</th></tr></thead>
      <tbody>{d.rows.map((r) => <tr><th scope="row">{r.topic}</th><td>{r.garage}</td><td>{r.other}</td></tr>)}</tbody>
    </table>
  </div>

  <Content />

  <h2>When you do not need claude-garage</h2>
  <ul>{d.notNeeded.map((w) => <li>{w}</li>)}</ul>

  <h2>Frequently asked questions</h2>
  {d.faq.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}

  <h2>Next steps</h2>
  <ul>
    <li><a href="/docs/getting-started/install/">Install claude-garage</a> (macOS, Linux, Windows preview).</li>
    <li><a href="/docs/guides/many-sessions/">Run many sessions</a> and <a href="/docs/guides/nothing-lost/">keep them alive</a>.</li>
    <li><a href="/docs/guides/plugins/">Plugins</a> and <a href="/docs/guides/first-plugin/">build your first plugin</a>.</li>
  </ul>
  <h2>Related comparisons</h2>
  <ul>{related.map((r) => <li><a href={`/compare/${r.id}/`}>{r.title}</a></li>)}</ul>
  <p class="note">Disclosure: claude-garage is made by the author of this page. Claims about it come from its source code and docs. No other product is named here.</p>
</Page>
