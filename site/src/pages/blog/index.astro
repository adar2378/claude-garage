---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { ID, WEBSITE, PUBLISHER, SOFTWARE, AUTHOR, abs, breadcrumbs, dayOf, isoDate, longDate, sharedNodes } from '../../lib/site';

const posts = (await getCollection('blog', (p) => import.meta.env.DEV || !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const blogUrl = abs('/blog/');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...sharedNodes(),
    {
      '@type': 'Blog',
      '@id': ID.blog,
      name: 'claude-garage blog',
      url: blogUrl,
      description: 'Notes on running many Claude Code sessions, the design of claude-garage, and its plugin system.',
      inLanguage: 'en',
      isPartOf: WEBSITE,
      about: SOFTWARE,
      author: AUTHOR,
      publisher: PUBLISHER,
      blogPost: posts.map((p) => ({ '@id': abs(`/blog/${p.id}/#article`) })),
    },
    breadcrumbs([['Home', '/'], ['Blog', '/blog/']]),
  ],
};
---
<Page title="claude-garage blog: sessions, tmux and plugins" description="Short, factual posts on running many Claude Code sessions, why tmux owns them, and how claude-garage plugins stay under your control." jsonLd={jsonLd} active="blog">
  <h1>Blog</h1>
  <p class="lead">Notes on running many Claude Code sessions, how claude-garage is built, and why. By <a href="/about/">Saiful Islam (Adar)</a>.</p>
  <ul class="cards">
    {posts.map((p) => (
      <li><a class="card" href={`/blog/${p.id}/`}>
        <time datetime={dayOf(p.data.date)}>{longDate(p.data.date)}{p.data.draft ? ' (draft)' : ''}</time>
        <strong>{p.data.title}</strong>
        <span>{p.data.description}</span>
      </a></li>
    ))}
  </ul>
  <p>Subscribe with <a href="/blog/rss.xml">RSS</a>. New here? Start with the <a href="/docs/guides/install/">install guide</a> or see <a href="/compare/">how claude-garage compares</a> with other ways to run sessions.</p>
</Page>
