---
// STUB. The real landing design replaces this component later.
// Keep the export shape: a single default component with no required props.
---
<main class="landing">
  <h1>claude-garage</h1>
  <p>A terminal wall for Claude Code. See every session at once and jump to the one that needs you.</p>
  <p class="actions">
    <a class="site-btn-primary" href="/docs/getting-started/install/">Get started</a>
    <a class="secondary" href="/docs/">Read the docs</a>
  </p>
</main>
<style>
  .landing { max-width: 42rem; margin: 0 auto; padding: 18vh 1.5rem 4rem; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.5rem); letter-spacing: -0.03em; margin: 0 0 1rem; color: var(--sl-color-white); }
  p { font-size: 1.15rem; line-height: 1.6; color: var(--sl-color-gray-2); }
  .actions { display: flex; gap: 1rem; align-items: center; margin-top: 2rem; }
  .site-btn-primary { padding: 0.65rem 1.2rem; border-radius: 0.5rem; text-decoration: none; border: 1px solid var(--brand); }
  .secondary { color: var(--brand-high); }
</style>
