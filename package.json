{
  "name": "claude-garage",
  "version": "0.2.0",
  "description": "Multiple Claude agents driving you crazy? Park them all in one garage: every session on one live terminal wall, no window juggling. Needs-input triage, worktree isolation, diff review. tmux owns the sessions; close the app and nothing dies.",
  "license": "MIT",
  "author": "Saiful Islam <saifulislamadar@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adar2378/claude-garage.git"
  },
  "homepage": "https://github.com/adar2378/claude-garage#readme",
  "bugs": "https://github.com/adar2378/claude-garage/issues",
  "keywords": [
    "claude",
    "claude-code",
    "tmux",
    "terminal",
    "agents",
    "session-manager",
    "dashboard",
    "xterm",
    "git-worktree",
    "developer-tools"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "claude-garage": "bin/garage.js"
  },
  "files": [
    "bin",
    "daemon/src",
    "daemon/package.json",
    "ui/dist"
  ],
  "workspaces": [
    "daemon",
    "ui"
  ],
  "scripts": {
    "dev": "concurrently -n daemon,ui -c blue,magenta \"npm:dev --workspace daemon\" \"npm:dev --workspace ui\"",
    "test": "node --test \"daemon/test/*.test.js\" \"ui/test/*.test.js\"",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
    "prepack": "npm run build --workspace ui"
  },
  "dependencies": {
    "@fastify/static": "^10.1.0",
    "fastify": "^5.3.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
