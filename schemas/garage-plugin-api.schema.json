{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApiTypes",
  "description": "Root of the published schema: one field per public type, so every type is\na named definition (the SDK generators turn definitions into types).",
  "type": "object",
  "properties": {
    "ack": {
      "$ref": "#/definitions/Ack"
    },
    "close_pane_response": {
      "$ref": "#/definitions/ClosePaneResponse"
    },
    "error": {
      "$ref": "#/definitions/ErrorBody"
    },
    "event_name": {
      "$ref": "#/definitions/EventName"
    },
    "event_payloads": {
      "$ref": "#/definitions/EventPayloads"
    },
    "features_response": {
      "$ref": "#/definitions/FeaturesResponse"
    },
    "health": {
      "$ref": "#/definitions/Health"
    },
    "notice_request": {
      "$ref": "#/definitions/NoticeRequest"
    },
    "open_pane_response": {
      "$ref": "#/definitions/OpenPaneResponse"
    },
    "panes_response": {
      "$ref": "#/definitions/PanesResponse"
    },
    "plugin_list": {
      "$ref": "#/definitions/PluginList"
    },
    "put_widget_response": {
      "$ref": "#/definitions/PutWidgetResponse"
    },
    "run_context": {
      "$ref": "#/definitions/RunContext"
    },
    "session_input_request": {
      "$ref": "#/definitions/SessionInputRequest"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Session"
      }
    },
    "ui_action_frame": {
      "$ref": "#/definitions/UiActionFrame"
    },
    "ui_action_request": {
      "$ref": "#/definitions/UiActionRequest"
    },
    "usage": {
      "$ref": "#/definitions/Usage"
    },
    "widget_item": {
      "$ref": "#/definitions/WidgetItem"
    },
    "widget_put": {
      "$ref": "#/definitions/WidgetPut"
    },
    "widgets_snapshot": {
      "$ref": "#/definitions/WidgetsSnapshot"
    },
    "workspaces": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Workspace"
      }
    }
  },
  "required": [
    "widget_put",
    "widget_item",
    "put_widget_response",
    "ui_action_request",
    "ui_action_frame",
    "notice_request",
    "session_input_request",
    "open_pane_response",
    "close_pane_response",
    "plugin_list",
    "widgets_snapshot",
    "panes_response",
    "run_context",
    "event_name",
    "event_payloads",
    "features_response",
    "health",
    "sessions",
    "workspaces",
    "usage",
    "error",
    "ack"
  ],
  "definitions": {
    "Ack": {
      "description": "`{\"ok\": true}` acknowledgements.",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ]
    },
    "ActionSummary": {
      "type": "object",
      "properties": {
        "confirm": {
          "type": "boolean",
          "default": false
        },
        "contexts": {
          "description": "`global`, `workspace` or `session`: what must be focused.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "default_key": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "description": "The full id, `plugin:action`.",
          "type": "string"
        },
        "pane": {
          "description": "The local pane id when the action opens a pane instead of running a command.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "AttachSpec": {
      "description": "How a client attaches a terminal to a session: the seam between the TUI's\nHow the TUI attaches to a session. Deliberately data, not a command line:\nthe TUI builds the fixed command itself, so whatever answers on the daemon\nport can never make it run an arbitrary program or dial an arbitrary host.",
      "oneOf": [
        {
          "description": "`tmux [-L <socket>] attach -t =<session>` in a PTY. `socket` matches\n`^[A-Za-z0-9_-]{1,64}$` or the TUI refuses it.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tmux"
            },
            "socket": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "The session runs in a host process registered as `hosts/<id>.json` in\nthe garage dir (user-private); the TUI reads address and token there.\nThe token is never sent over HTTP. An empty `id` means \"no such host\".",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "host"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "ButtonSummary": {
      "type": "object",
      "properties": {
        "args": {
          "default": null
        },
        "confirm": {
          "type": "boolean",
          "default": false
        },
        "label": {
          "type": "string"
        },
        "on_click": {
          "description": "A core id, `plugin:action`, or a bare local id.",
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "slot": {
          "$ref": "#/definitions/WidgetSlot"
        },
        "tooltip": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "slot",
        "label",
        "on_click"
      ]
    },
    "Click": {
      "description": "What a click on a segment (or a whole row) runs. `action` is a core id,\n`plugin:action`, or a bare local id.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "args": true
      },
      "required": [
        "action"
      ]
    },
    "ClosePaneResponse": {
      "description": "Reply of `DELETE /api/plugins/{id}/panes/{pane}`.",
      "type": "object",
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "closed"
      ]
    },
    "Context": {
      "description": "`context` of a session list entry. The percentage is clamped to 0-100 by\nthe daemon but may be fractional (statusline) or rounded (transcript).",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/ContextSource"
        },
        "usedPercentage": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "usedPercentage",
        "source"
      ]
    },
    "ContextEvent": {
      "type": "object",
      "properties": {
        "at": {
          "description": "Unix milliseconds.",
          "type": "integer",
          "format": "int64"
        },
        "data": {
          "description": "The payload; its shape depends on `name` (see [`EventPayloads`])."
        },
        "name": {
          "description": "One of the event names (see [`EventName`]).",
          "type": "string"
        }
      },
      "required": [
        "name",
        "at",
        "data"
      ]
    },
    "ContextFocus": {
      "type": "object",
      "properties": {
        "dir": {
          "description": "CLI runs only: the caller's working directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContextSession"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "workspace",
        "session"
      ]
    },
    "ContextPlugin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "state_dir": {
          "description": "The plugin's own writable folder.",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "state_dir"
      ]
    },
    "ContextSelection": {
      "type": "object",
      "properties": {
        "index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "view": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "session",
        "index",
        "view"
      ]
    },
    "ContextSession": {
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContextWorktree"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "dir",
        "status",
        "branch",
        "worktree"
      ]
    },
    "ContextSource": {
      "type": "string",
      "enum": [
        "statusline",
        "transcript"
      ]
    },
    "ContextTrigger": {
      "type": "object",
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "description": "The `args` of the button or click; `{}` when none. For a `cli` run,\n`{\"argv\": [...]}`."
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "`key`, `button`, `widget`, `palette`, `event`, `timer`, `pane` or `cli`.",
          "type": "string"
        },
        "slot": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "key",
        "slot",
        "action",
        "args"
      ]
    },
    "ContextUi": {
      "type": "object",
      "properties": {
        "slots": {
          "description": "Slot geometry the wall reported (`width`, `max_cols`, `filler`), by\nslot name. May be empty."
        }
      },
      "required": [
        "slots"
      ]
    },
    "ContextWorktree": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "repo_dir": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "branch",
        "repo_dir"
      ]
    },
    "ErrorBody": {
      "description": "Body of every non-2xx response: `{\"error\": \"...\"}`. Routes may add fields.",
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ]
    },
    "EventName": {
      "description": "Event names a manifest `[[events]] on` may use.",
      "type": "string",
      "enum": [
        "session.created",
        "session.closed",
        "session.turn",
        "session.forgotten",
        "session.status_changed",
        "worktree.created",
        "workspace.added",
        "workspace.removed",
        "daemon.started",
        "timer"
      ]
    },
    "EventPayloads": {
      "description": "The payload (`event.data`) of each event, by event name. `daemon.started`\nand `timer` carry `{}`.",
      "type": "object",
      "properties": {
        "session.closed": {
          "$ref": "#/definitions/SessionClosed"
        },
        "session.created": {
          "$ref": "#/definitions/SessionCreated"
        },
        "session.forgotten": {
          "$ref": "#/definitions/SessionForgotten"
        },
        "session.status_changed": {
          "$ref": "#/definitions/SessionStatusChanged"
        },
        "session.turn": {
          "$ref": "#/definitions/SessionTurn"
        },
        "workspace.added": {
          "$ref": "#/definitions/WorkspaceNamed"
        },
        "workspace.removed": {
          "$ref": "#/definitions/WorkspaceNamed"
        },
        "worktree.created": {
          "$ref": "#/definitions/WorktreeCreated"
        }
      },
      "required": [
        "session.created",
        "session.closed",
        "session.turn",
        "session.forgotten",
        "session.status_changed",
        "worktree.created",
        "workspace.added",
        "workspace.removed"
      ]
    },
    "FeatureLimits": {
      "type": "object",
      "properties": {
        "notice_chars": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "widget_body_bytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "widget_cols": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "widget_frames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "widget_items": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "widget_puts_per_sec": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "widget_segments": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "widget_ttl_secs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "widget_items",
        "widget_segments",
        "widget_cols",
        "widget_body_bytes",
        "widget_puts_per_sec",
        "widget_ttl_secs",
        "widget_frames",
        "notice_chars"
      ]
    },
    "Features": {
      "description": "The `features` object. New keys may appear in later garage versions.",
      "type": "object",
      "properties": {
        "actions.core_invocable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "api.v1.frozen": {
          "type": "boolean"
        },
        "cli.fallback": {
          "type": "boolean"
        },
        "dangerous_permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "$ref": "#/definitions/FeatureLimits"
        },
        "panes.placements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RouteInfo"
          }
        },
        "sessions.input": {
          "type": "boolean"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "theme_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ui.notice": {
          "type": "boolean"
        },
        "widgets.animated": {
          "type": "boolean"
        },
        "widgets.click_args": {
          "type": "boolean"
        },
        "widgets.filler": {
          "type": "boolean"
        },
        "widgets.frame_x": {
          "type": "boolean"
        },
        "widgets.slot_geometry": {
          "type": "boolean"
        }
      },
      "required": [
        "api.v1.frozen",
        "events",
        "permissions",
        "dangerous_permissions",
        "theme_tokens",
        "routes",
        "slots",
        "widgets.click_args",
        "widgets.filler",
        "widgets.animated",
        "widgets.frame_x",
        "widgets.slot_geometry",
        "ui.notice",
        "cli.fallback",
        "panes.placements",
        "sessions.input",
        "actions.core_invocable",
        "limits"
      ]
    },
    "FeaturesResponse": {
      "description": "`GET /api/plugin/features`.",
      "type": "object",
      "properties": {
        "api_versions": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "features": {
          "$ref": "#/definitions/Features"
        },
        "garage": {
          "description": "The garage version.",
          "type": "string"
        }
      },
      "required": [
        "api_versions",
        "garage",
        "features"
      ]
    },
    "Health": {
      "description": "`GET /api/health`.",
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "pid"
      ]
    },
    "IfStatus": {
      "description": "Refuse the input (409) when the session is in one of these statuses.",
      "type": "object",
      "properties": {
        "not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "not"
      ]
    },
    "NoticeRequest": {
      "description": "`POST /api/plugins/{id}/notice` (needs `ui.notice`).",
      "type": "object",
      "properties": {
        "text": {
          "description": "Cut to 120 characters.",
          "type": "string"
        },
        "ttl_ms": {
          "description": "1000..=10000, default 5000.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "text"
      ]
    },
    "OpenPaneResponse": {
      "description": "Reply of `POST /api/plugins/{id}/panes/{pane}/open`.",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reused": {
          "description": "The pane was already open (a singleton) and was reused.",
          "type": "boolean"
        },
        "session": {
          "description": "The backend session id of the pane.",
          "type": "string"
        }
      },
      "required": [
        "ok",
        "session",
        "reused"
      ]
    },
    "PaneInstance": {
      "description": "One open plugin pane, with how to attach to it.",
      "type": "object",
      "properties": {
        "attach": {
          "$ref": "#/definitions/AttachSpec"
        },
        "cols": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "pane": {
          "type": "string"
        },
        "pct": {
          "type": "boolean",
          "default": false
        },
        "placement": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "rows": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "session": {
          "description": "The backend session id (`plugin/<plugin>/<pane>`); not a `garage/` id,\nso it is never in the session list.",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "plugin",
        "pane",
        "title",
        "placement",
        "session",
        "attach"
      ]
    },
    "PaneSummary": {
      "type": "object",
      "properties": {
        "cols": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "pct": {
          "description": "`cols`/`rows` are percent of the screen.",
          "type": "boolean",
          "default": false
        },
        "placement": {
          "description": "`tile`, `overlay` or `popup`.",
          "type": "string"
        },
        "rows": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "placement"
      ]
    },
    "PanesResponse": {
      "description": "`GET /api/plugins/panes`.",
      "type": "object",
      "properties": {
        "panes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PaneInstance"
          }
        }
      },
      "required": [
        "panes"
      ]
    },
    "Placement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "flow"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Strip only: drawn at column `x`, after the flow items.",
          "type": "object",
          "properties": {
            "caption": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "filler"
            },
            "x": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "x"
          ]
        }
      ]
    },
    "PluginList": {
      "description": "`GET /api/plugins`: the plugins in install order (which is also the\ntiebreak for two plugins that suggest the same key).",
      "type": "object",
      "properties": {
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PluginSummary"
          }
        }
      },
      "required": [
        "plugins"
      ]
    },
    "PluginSummary": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/ActionSummary"
          }
        },
        "active": {
          "description": "Enabled, approved, loaded: only an active plugin's actions, buttons\nand widgets reach the screen.",
          "type": "boolean"
        },
        "bindings": {
          "description": "The user's own key bindings (`action` local id to key).",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
