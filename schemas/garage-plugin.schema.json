{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique id: `^[a-z][a-z0-9-]{1,30}$`, not a reserved word.",
      "type": "string"
    },
    "name": {
      "description": "Display name.",
      "type": "string"
    },
    "version": {
      "description": "Semver.",
      "type": "string"
    },
    "api_version": {
      "description": "The plugin API major version.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "platforms": {
      "description": "Systems the plugin runs on.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Platform"
      }
    },
    "description": {
      "description": "One line for the install preview and `plugin list`.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "homepage": {
      "description": "A URL shown in the install preview.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "requires": {
      "description": "Feature names from `/api/plugins/features` the plugin needs.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "permissions": {
      "description": "What the plugin uses. Shown at install; the daemon checks it on API calls.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Permission"
      },
      "default": []
    },
    "actions": {
      "description": "Commands bindable to keys, buttons and the palette (`[[actions]]`).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Action"
      },
      "default": []
    },
    "events": {
      "description": "Commands run when something happens (`[[events]]`).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/EventHook"
      },
      "default": []
    },
    "panes": {
      "description": "Programs shown in a tile, overlay or popup (`[[panes]]`).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Pane"
      },
      "default": []
    },
    "widgets": {
      "description": "Named spots the plugin fills at runtime (`[[widgets]]`).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Widget"
      },
      "default": []
    },
    "buttons": {
      "description": "Clickable labels that run an action (`[[buttons]]`).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Button"
      },
      "default": []
    },
    "cli": {
      "description": "Subcommands of `claude-garage` (`[[cli]]`).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Cli"
      },
      "default": []
    },
    "build": {
      "description": "Commands run once at install and update (`[[build]]`).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Build"
      },
      "default": []
    },
    "release": {
      "description": "Per-system binary downloads that replace `[[build]]` (`[release]`).",
      "anyOf": [
        {
          "$ref": "#/definitions/Release"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "api_version",
    "platforms"
  ],
  "definitions": {
    "Platform": {
      "type": "string",
      "enum": [
        "macos",
        "linux",
        "windows"
      ]
    },
    "Permission": {
      "type": "string",
      "enum": [
        "sessions.read",
        "sessions.input",
        "ui.widgets",
        "ui.panes",
        "ui.invoke",
        "core.actions",
        "ui.navigate",
        "ui.notice"
      ]
    },
    "Action": {
      "description": "Bindable to keys and buttons. Exactly one of `command` / `pane`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Local id; the full id is `<plugin>:<id>`.",
          "type": "string"
        },
        "title": {
          "description": "Shown in help and the palette.",
          "type": "string"
        },
        "contexts": {
          "description": "What must be focused for the action to be available.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ActionContext"
          },
          "default": [
            "global"
          ]
        },
        "command": {
          "description": "The program and arguments to run (no shell). Exactly one of `command` and `pane`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "pane": {
          "description": "Open one of this plugin's panes instead of running a command.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "default_key": {
          "description": "A suggestion; never overrides an existing binding.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "confirm": {
          "description": "Ask the user before a plugin-origin trigger (click, `ui/action`) runs it.",
          "type": "boolean",
          "default": false
        },
        "timeout_secs": {
          "description": "1..=300, default 30.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ]
    },
    "ActionContext": {
      "description": "What must be focused for an action to be available.",
      "type": "string",
      "enum": [
        "global",
        "workspace",
        "session"
      ]
    },
    "EventHook": {
      "type": "object",
      "properties": {
        "on": {
          "description": "The event, or `timer`.",
          "allOf": [
            {
              "$ref": "#/definitions/EventName"
            }
          ]
        },
        "every_secs": {
          "description": "Only with `on = \"timer\"`; at least 5.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "command": {
          "description": "The program and arguments to run (no shell).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout_secs": {
          "description": "1..=60, default 10.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "on",
        "command"
      ]
    },
    "EventName": {
      "type": "string",
      "enum": [
        "session.created",
        "session.closed",
        "session.turn",
        "session.forgotten",
        "session.status_changed",
        "worktree.created",
        "workspace.added",
        "workspace.removed",
        "daemon.started",
        "timer"
      ]
    },
    "Pane": {
      "description": "Runs as a backend session.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Local id, used in `pane = \"...\"` and the open-pane route.",
          "type": "string"
        },
        "title": {
          "description": "Shown in the pane frame.",
          "type": "string"
        },
        "placement": {
          "description": "Where it appears.",
          "allOf": [
            {
              "$ref": "#/definitions/PanePlacement"
            }
          ]
        },
        "command": {
          "description": "The program and arguments to run (no shell).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "singleton": {
          "description": "Opening again focuses the existing pane. Default true.",
          "type": "boolean",
          "default": true
        },
        "size": {
          "description": "A size hint for overlay and popup panes.",
          "anyOf": [
            {
              "$ref": "#/definitions/PaneSize"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "placement",
        "command"
      ]
    },
    "PanePlacement": {
      "type": "string",
      "enum": [
        "tile",
        "overlay",
        "popup"
      ]
    },
    "PaneSize": {
      "type": "object",
      "properties": {
        "cols": {
          "description": "Columns (or percent of the screen width).",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "rows": {
          "description": "Rows (or percent of the screen height).",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "pct": {
          "description": "`cols`/`rows` are percent of the screen.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "cols",
        "rows"
      ]
    },
    "Widget": {
      "description": "Content is pushed at runtime over the daemon API.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Local id, used in the push route.",
          "type": "string"
        },
        "slot": {
          "description": "Where it is drawn; decides the scope key of its content.",
          "allOf": [
            {
              "$ref": "#/definitions/Slot"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "slot"
      ]
    },
    "Slot": {
      "type": "string",
      "enum": [
        "tile.title.right",
        "tile.gutter",
        "rail.row",
        "rail.extra_rows",
        "rail.header",
        "strip.right"
      ]
    },
    "Button": {
      "type": "object",
      "properties": {
        "slot": {
          "description": "Where the button is drawn.",
          "allOf": [
            {
              "$ref": "#/definitions/Slot"
            }
          ]
        },
        "label": {
          "description": "The text of the button.",
          "type": "string"
        },
        "tooltip": {
          "description": "Shown on hover.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "on_click": {
          "description": "A core id, `plugin:action`, or a bare local action id.",
          "type": "string"
        },
        "args": {
          "description": "JSON passed as `trigger.args`.",
          "default": null
        },
        "confirm": {
          "description": "May only add confirmation; a core action's own cannot be removed.",
          "type": "boolean",
          "default": false
        },
        "priority": {
          "description": "Higher survives narrow widths.",
          "type": "integer",
          "format": "int32",
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "slot",
        "label",
        "on_click"
      ]
    },
    "Cli": {
      "description": "Exposed as `claude-garage <name>`.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The subcommand: `claude-garage <name>`.",
          "type": "string"
        },
        "description": {
          "description": "Shown in help.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "command": {
          "description": "The program and arguments to run (no shell).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "description": "Also receives an unknown first word. At most one installed plugin.",
          "type": "boolean",
          "default": false
        },
        "needs_daemon": {
          "description": "`claude-garage` makes sure a current daemon is running before the\ncommand starts (the command calls the daemon API).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "command"
      ]
    },
    "Build": {
      "description": "Run once at install.",
      "type": "object",
      "properties": {
        "platforms": {
          "description": "Default: all header platforms.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Platform"
          },
          "default": []
        },
        "command": {
          "description": "The program and arguments to run (no shell).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout_secs": {
          "description": "Default 600.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "Release": {
      "description": "Per-OS binary assets; when the current target is listed `[[build]]` is\nskipped.",
      "type": "object",
      "properties": {
        "repo": {
          "description": "Default: the repo the plugin was installed from.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tag": {
          "description": "Template; `{version}` is replaced.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "checksums": {
          "description": "Asset holding `<sha256>  <asset>` lines.",
          "type": "string"
        },
        "assets": {
          "description": "`os-arch` (for example `macos-aarch64`) to asset name.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "checksums"
      ]
    }
  }
}
